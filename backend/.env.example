# Copy to .env and fill in overrides only when needed.
# Empty values use the defaults documented in README.md.
APP_NAME=
DOCS_ENABLED=
# JSON array of HTTP(S) origins; no wildcard or URL path.
CORS_ORIGINS=
# Docker network origin; ai-engine does not need a published host port.
AI_ENGINE_URL=http://ai-engine:8001
# Total deadline as well as HTTP I/O timeout, in seconds. No retries.
AI_ENGINE_TIMEOUT_SECONDS=2
# Voice interpretation. Empty key: development stub replies, OpenAI is not called.
OPENAI_API_KEY=
OPENAI_MODEL=
# Total deadline per OpenAI call, in seconds. No retries.
OPENAI_TIMEOUT_SECONDS=
# true: completed voice results change the cart (actions: cart_updated). Empty/false: tool_calls only.
VOICE_EXECUTE_TOOLS=
